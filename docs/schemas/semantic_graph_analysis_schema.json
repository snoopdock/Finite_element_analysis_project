{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/semantic_graph_analysis_schema.json",
  "title": "Semantic Graph Analysis Artifact",
  "type": "object",
  "required": ["schema_version", "result_count", "results"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "semantic_graph_analysis/v1"},
    "result_count": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "schema_version", "analysis_id", "query_id", "analysis_type", "status",
        "algorithm", "graph_fingerprint", "source_entities", "discovered_entities",
        "observations", "evidence", "verification_summary", "parameters", "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "semantic_graph_analysis/v1"},
        "analysis_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "analysis_type": {"enum": ["structural", "dependency", "path", "traversal", "centrality"]},
        "status": {"enum": ["completed", "no_match"]},
        "algorithm": {"type": "string", "minLength": 1},
        "graph_fingerprint": {"type": "string", "minLength": 1},
        "source_entities": {"type": "array", "items": {"type": "string"}},
        "discovered_entities": {"type": "array", "items": {"type": "string"}},
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "verification_summary": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "parameters": {"type": "object"},
        "metadata": {"type": "object"}
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "observation_id", "subject_id", "predicate", "object_id",
        "evidence_ids", "depth", "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "depth": {"type": "integer", "minimum": 1},
        "metadata": {"type": "object"}
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id", "subject_id", "predicate", "object_id",
        "verification_status", "source_kind", "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["observed", "corroborated", "validated", "rejected"]},
        "source_kind": {"type": "string", "minLength": 1},
        "provenance": {"type": "object"}
      }
    }
  }
}
