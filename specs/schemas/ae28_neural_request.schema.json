{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AE-28 Neural Interpretation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "base_contract_sha256",
    "base_graph_fingerprint",
    "base_semantic_fingerprint",
    "base_hypothesis_fingerprint",
    "vocabulary_digest",
    "context_occurrences",
    "task_digest",
    "input_manifest",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ae28/neural-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "base_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_graph_fingerprint": {
      "type": "string",
      "pattern": "^graph:[0-9a-f]{32}$"
    },
    "base_semantic_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_hypothesis_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vocabulary_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_occurrences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_manifest": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
