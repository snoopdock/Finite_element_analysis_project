{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNF RUP UNSAT Proof Certificate",
  "type": "object",
  "required": ["kind", "proof_format", "cnf_digest", "steps"],
  "properties": {
    "kind": {"const": "unsat_proof"},
    "proof_format": {"const": "cnf-rup/v1"},
    "cnf_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {"type": "integer", "not": {"const": 0}}
      }
    }
  },
  "additionalProperties": false
}
