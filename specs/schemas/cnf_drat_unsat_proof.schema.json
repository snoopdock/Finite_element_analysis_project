{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-audit/cnf-drat-unsat-proof/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "proof_format", "cnf_digest", "steps"],
  "properties": {
    "kind": {"const": "unsat_proof"},
    "proof_format": {"const": "cnf-drat/v1"},
    "cnf_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "clause"],
        "properties": {
          "op": {"enum": ["add", "delete"]},
          "clause": {
            "type": "array",
            "items": {"type": "integer", "not": {"const": 0}}
          }
        }
      }
    }
  }
}
