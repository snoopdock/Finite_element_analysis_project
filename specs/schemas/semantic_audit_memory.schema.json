{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_audit_memory.schema.json",
  "title": "Semantic Audit Long-Term Memory",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "semantic_audit_memory/v1"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "artifact_type", "artifact_id", "snapshot_id", "payload"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "snapshot_id": {"type": "string", "minLength": 1},
          "payload": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
