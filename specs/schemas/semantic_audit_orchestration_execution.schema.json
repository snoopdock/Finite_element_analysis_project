{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_audit_orchestration_execution/v1",
  "type": "object",
  "required": ["schema_version", "execution_id", "plan_id", "policy_version", "objective_results", "receipts", "consumed_cost_units", "consumed_verifier_runs"],
  "properties": {
    "schema_version": {"const": "semantic_audit_orchestration_execution/v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "consumed_cost_units": {"type": "integer", "minimum": 0},
    "consumed_verifier_runs": {"type": "integer", "minimum": 0},
    "remaining_cost_units": {"type": "integer", "minimum": 0},
    "objective_results": {"type": "array"},
    "receipts": {"type": "array"}
  },
  "additionalProperties": true
}
