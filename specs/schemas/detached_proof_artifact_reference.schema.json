{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-audit/detached-proof-artifact-reference/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "store_id", "artifact_sha256", "byte_size", "proof_format",
    "cnf_digest", "artifact_format", "media_type"
  ],
  "properties": {
    "kind": {"const": "unsat_proof_ref"},
    "schema_version": {"const": "semantic_proof_artifact_reference/v1"},
    "store_id": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 1},
    "proof_format": {"enum": ["cnf-rup/v1", "cnf-drat/v1"]},
    "cnf_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_format": {"const": "semantic_cnf_proof_jsonl/v1"},
    "media_type": {"const": "application/x-semantic-cnf-proof+jsonl"}
  }
}
