{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic_reverification_execution.schema.json",
  "title": "Semantic Reverification Execution Result",
  "type": "object",
  "required": [
    "schema_version", "execution_id", "plan_id", "before_snapshot_id",
    "after_snapshot_id", "succeeded", "task_executions", "replacements",
    "analyses", "obligations", "receipts", "evaluations", "findings"
  ],
  "properties": {
    "schema_version": {"const": "semantic_reverification_execution/v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "before_snapshot_id": {"type": "string", "minLength": 1},
    "after_snapshot_id": {"type": "string", "minLength": 1},
    "succeeded": {"type": "boolean"},
    "task_executions": {"type": "array", "items": {"type": "object"}},
    "replacements": {"type": "array", "items": {"type": "object"}},
    "analyses": {"type": "array", "items": {"type": "object"}},
    "obligations": {"type": "array", "items": {"type": "object"}},
    "receipts": {"type": "array", "items": {"type": "object"}},
    "evaluations": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
