{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled External Process Transcript",
  "type": "object",
  "required": ["process_id", "process_version", "executable_sha256", "input_sha256", "stdout_sha256", "stderr_sha256", "return_code", "timeout_ms", "stdout_bytes", "stderr_bytes", "shell_used", "ephemeral_working_directory", "network_isolation_enforced", "filesystem_isolation_enforced"],
  "properties": {
    "process_id": {"type": "string", "minLength": 1},
    "process_version": {"type": "string", "minLength": 1},
    "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "return_code": {"type": "integer"},
    "timeout_ms": {"type": "integer", "minimum": 1},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "shell_used": {"const": false},
    "ephemeral_working_directory": {"const": true},
    "network_isolation_enforced": {"const": false},
    "filesystem_isolation_enforced": {"const": false}
  },
  "additionalProperties": false
}
