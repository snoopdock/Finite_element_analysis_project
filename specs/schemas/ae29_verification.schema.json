{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": {
        "authoritative_checkout_mutation_permitted": false,
        "repository_truth_verified": false
      }
    },
    "checks": {
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
    },
    "input_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "output_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "repair_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "ae29/repair-verification/v1"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "verification_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verifier": {
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "repair_sha256",
    "input_snapshot_sha256",
    "output_snapshot_sha256",
    "verifier",
    "run_sha256",
    "status",
    "checks",
    "authority",
    "verification_sha256"
  ],
  "title": "AE-29 Repair Verification",
  "type": "object"
}
