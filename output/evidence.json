  {
    "source_id": "arxiv_2410.12614v1",
    "url": "https://arxiv.org/pdf/2410.12614v1.pdf",
    "retrieved_at": "2026-10-05T14:43:07.767557+00:00",
    "retriever_module": "research.arxiv_fulltext",
