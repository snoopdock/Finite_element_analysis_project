{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAT Claim Review Dossier v1",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_audit_sha256",
    "draft_sha256",
    "source_commit_sha",
    "retrieval_context_sha256",
    "source_record_count",
    "sources",
    "claim_reviews",
    "trace_summary",
    "human_review",
    "execution_constraints",
    "limitations",
    "dossier_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "sat-claim-review-dossier/v1"
    },
    "proposal_audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retrieval_context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "sources": {
      "type": "array"
    },
    "claim_reviews": {
      "type": "array",
      "minItems": 1
    },
    "trace_summary": {
      "type": "object"
    },
    "human_review": {
      "type": "object",
      "properties": {
        "status": {
          "const": "pending"
        },
        "required": {
          "const": true
        },
        "authorization_granted": {
          "const": false
        }
      },
      "required": [
        "status",
        "required",
        "authorization_granted"
      ]
    },
    "execution_constraints": {
      "type": "object",
      "properties": {
        "automated_sat_action_allowed": {
          "const": false
        },
        "repository_writeback_allowed": {
          "const": false
        },
        "learned_rule_promotion_allowed": {
          "const": false
        },
        "publication_as_verified_engineering_text_allowed": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1
    },
    "dossier_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
