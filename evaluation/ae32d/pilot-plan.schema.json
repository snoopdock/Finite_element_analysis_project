{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AE-32D pilot plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "protocol_version",
    "status",
    "target_case_count",
    "eventual_benchmark_case_count",
    "current_case_status",
    "required_case_mix",
    "conditions",
    "optional_later_condition",
    "primary_metric",
    "independent_reviewers_per_high_value_case",
    "holdout_policy",
    "current_gate",
    "approval_required_before_scoring",
    "prohibited_shortcuts"
  ],
  "properties": {
    "schema_version": {
      "const": "ae32d/pilot-plan/v1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft_pending_approval",
        "frozen",
        "retired"
      ]
    },
    "target_case_count": {
      "type": "object",
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "eventual_benchmark_case_count": {
      "type": "object",
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "current_case_status": {
      "type": "object",
      "required": [
        "candidate_count",
        "adjudicated_count",
        "primary_score_eligible_count",
        "candidate_case_ids"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "adjudicated_count": {
          "type": "integer",
          "minimum": 0
        },
        "primary_score_eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_case_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_case_mix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "optional_later_condition": {
      "type": "string"
    },
    "primary_metric": {
      "type": "string"
    },
    "independent_reviewers_per_high_value_case": {
      "type": "integer",
      "minimum": 0
    },
    "holdout_policy": {
      "type": "string"
    },
    "current_gate": {
      "type": "string"
    },
    "approval_required_before_scoring": {
      "type": "boolean"
    },
    "prohibited_shortcuts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
