{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ae32d-sanitized-task-projection.schema.json",
  "title": "AE-32D sanitized executor task projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "source",
    "task",
    "experiment_id",
    "condition",
    "task_contract_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "ae32d/sanitized-task-projection/v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit_sha",
        "fixture_path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fixture_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "problem_statement",
        "declared_scope",
        "constraints"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "declared_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "A_deterministic",
        "B_graph"
      ]
    },
    "task_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
