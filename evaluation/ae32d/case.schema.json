{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/snoopdock/Finite_element_analysis_project/blob/stage1/section-uuids/evaluation/ae32d/case.schema.json",
  "title": "AE-32D audit-quality benchmark case",
  "description": "Versioned case record. Pending-adjudication cases are not eligible for primary benchmark scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_status",
    "source",
    "task",
    "ground_truth",
    "review",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "ae32d/case/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^AE32D-[A-Z0-9-]{3,80}$"
    },
    "case_status": {
      "enum": [
        "candidate",
        "adjudication_pending",
        "adjudicated",
        "excluded",
        "holdout"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit_sha",
        "fixture_path",
        "environment"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fixture_path": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "problem_statement",
        "declared_scope"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "declared_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "defect_family",
        "severity",
        "expected_findings",
        "verification"
      ],
      "properties": {
        "label": {
          "enum": [
            "confirmed_defect",
            "no_defect",
            "ambiguous",
            "pending_adjudication"
          ]
        },
        "defect_family": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational",
            "not_applicable",
            "pending"
          ]
        },
        "expected_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "statement",
              "locations",
              "supporting_evidence"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "line_start",
                    "line_end",
                    "role"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "line_end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "role": {
                      "enum": [
                        "trigger",
                        "cause",
                        "counterevidence",
                        "test",
                        "context"
                      ]
                    }
                  }
                }
              },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptable_alternatives": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "artifacts"
          ],
          "properties": {
            "status": {
              "enum": [
                "confirmed_fix",
                "test_reproduction",
                "independent_review",
                "fixture_construction_only",
                "pending_independent_review",
                "not_reproduced"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_independent_reviewers",
        "status",
        "reviewers",
        "adjudication",
        "agreement"
      ],
      "properties": {
        "required_independent_reviewers": {
          "type": "integer",
          "minimum": 2
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "adjudicated",
            "excluded"
          ]
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_id",
              "label",
              "confidence",
              "notes"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "enum": [
                  "confirmed_defect",
                  "no_defect",
                  "ambiguous",
                  "pending_adjudication"
                ]
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "not_assessed"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "adjudication": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreement": {
          "enum": [
            "agreement",
            "disagreement",
            "not_assessed",
            null
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_benchmark_eligible",
        "holdout",
        "abstention_acceptable",
        "conditions"
      ],
      "properties": {
        "primary_benchmark_eligible": {
          "type": "boolean"
        },
        "holdout": {
          "type": "boolean"
        },
        "abstention_acceptable": {
          "type": "boolean"
        },
        "conditions": {
          "type": "array",
          "items": {
            "enum": [
              "A_deterministic",
              "B_graph",
              "C_graph_llm",
              "D_claim_assessment"
            ]
          }
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
